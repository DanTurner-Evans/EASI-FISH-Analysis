import re
from pathlib import Path

configfile: "config/config.yaml"

RAW_DIR = Path("data/raw")

# Filenames look like A2_brain2, C1_brain1a, D3_brain1b:
#   <line letter><receptor set digit>_brain<number><optional a/b suffix>
SAMPLE_RE = re.compile(r"^(?P<line>[A-D])(?P<rset>[1-3])_brain(?P<brain>\d+[a-z]*)$")


def discover_samples():
    """Sample IDs are CZI stems found anywhere under data/raw (the CZIs live in
    per-line subdirectories). Names that are neither a valid sample nor an
    explicitly excluded scan fail loudly rather than being silently dropped."""
    excluded = set(config.get("exclude", []))
    found, bad = [], []
    for path in sorted(RAW_DIR.rglob("*.czi")):
        if path.stem in excluded:
            continue
        (found if SAMPLE_RE.match(path.stem) else bad).append(path.stem)
    if bad:
        raise WorkflowError(
            "Raw filenames are neither <line><set>_brain<n> nor listed under "
            "'exclude' in config.yaml: " + ", ".join(sorted(bad))
        )
    duplicates = {s for s in found if found.count(s) > 1}
    if duplicates:
        raise WorkflowError(
            "Duplicate sample IDs across subdirectories: " + ", ".join(sorted(duplicates))
        )
    return found


# CZIs are nested per line, so the path cannot be derived from the sample ID alone.
RAW_PATHS = {p.stem: p for p in sorted(RAW_DIR.rglob("*.czi"))}


SAMPLES = discover_samples()


def meta(sample):
    """Metadata implied by a sample ID, resolved through config.yaml."""
    m = SAMPLE_RE.match(sample).groupdict()
    return {
        "line_label": m["line"],
        "brain": m["brain"],
        "receptor_set": m["rset"],
        **config["lines"][m["line"]],
        "receptors": config["receptor_sets"][m["rset"]],
    }


wildcard_constraints:
    sample=r"[A-D][1-3]_brain\d+[a-z]*",
    channel=r"\d{3}",


rule all:
    input:
        "results/tables/spot_counts.csv",
        "results/tables/neurite_counts.csv",
        "results/figures/counts_by_receptor.pdf",


rule ingest:
    """Read the CZI once and write chunked zarr; every later rule reads this."""
    input:
        lambda wc: RAW_PATHS[wc.sample],
    output:
        directory("data/processed/{sample}/image.zarr"),
    resources:
        mem_mb=16000,
    log:
        "logs/ingest/{sample}.log",
    script:
        "scripts/ingest.py"


rule segment:
    """Label driver-line somata: fill the membrane signal, strip neurites, and
    split it into somata seeded by the Cellpose nuclei it encloses. Labels are
    on a downsampled grid."""
    input:
        "data/processed/{sample}/image.zarr",
    output:
        soma="data/processed/{sample}/soma_labels.tif",
        nuclei="data/processed/{sample}/nuclei_labels.tif",
        table="data/processed/{sample}/cells.csv",
        qc="results/figures/segmentation/{sample}_qc.png",
    params:
        segmentation=config["segmentation"],
    resources:
        mem_mb=24000,
    log:
        "logs/segment/{sample}.log",
    script:
        "scripts/segment.py"


rule detect_spots:
    """Propose mRNA puncta in one channel with Spotiflow. Runs once per sample
    per channel; the slow step, so it is kept apart from the threshold."""
    input:
        "data/processed/{sample}/image.zarr",
    output:
        "data/processed/{sample}/spot_candidates_{channel}.csv",
    params:
        detection={k: v for k, v in config["spot_detection"].items() if k != "min_amplitude"},
        emission_nm=lambda wc: config["channels"][wc.channel]["emission_nm"],
    threads: 8
    resources:
        # Set by slab size, not stack depth (see detect_spots.py).
        mem_mb=24000,
    log:
        "logs/detect_spots/{sample}_{channel}.log",
    script:
        "scripts/detect_spots.py"


rule filter_spots:
    """Apply the amplitude threshold to the candidates and draw a QC figure."""
    input:
        candidates="data/processed/{sample}/spot_candidates_{channel}.csv",
        image="data/processed/{sample}/image.zarr",
    output:
        spots="data/processed/{sample}/spots_{channel}.csv",
        qc="results/figures/spots/{sample}_{channel}_qc.png",
    params:
        min_amplitude=lambda wc: config["spot_detection"]["min_amplitude"][wc.channel],
        emission_nm=lambda wc: config["channels"][wc.channel]["emission_nm"],
    log:
        "logs/filter_spots/{sample}_{channel}.log",
    script:
        "scripts/filter_spots.py"


rule spots:
    """Target: filtered puncta and QC figures for every sample and channel,
    without needing segmentation."""
    input:
        expand("results/figures/spots/{sample}_{channel}_qc.png",
               sample=SAMPLES, channel=config["channels"]),


rule inspect:
    """Fiji hyperstacks of one sample for checking the segmentation and spot
    filter: the whole field on the segmentation grid, plus full-resolution
    crops and PNGs of each nucleus-free cell. Needs spot candidates, so it
    runs spot detection if that has not been done."""
    input:
        image=     "data/processed/{sample}/image.zarr",
        soma=      "data/processed/{sample}/soma_labels.tif",
        nuclei=    "data/processed/{sample}/nuclei_labels.tif",
        table=     "data/processed/{sample}/cells.csv",
        candidates=expand("data/processed/{{sample}}/spot_candidates_{channel}.csv",
                          channel=config["channels"]),
    output:
        directory("data/processed/{sample}/inspect"),
    params:
        segmentation=config["segmentation"],
        channels=list(config["channels"]),
        emission_nm={c: v["emission_nm"] for c, v in config["channels"].items()},
        min_amplitude=config["spot_detection"]["min_amplitude"],
        crop_um=config["inspect"]["crop_um"],
    resources:
        # Raw channels are read one at a time (~2.7 GB each); the overview
        # stack of the deepest sample is ~1.6 GB.
        mem_mb=12000,
    log:
        "logs/inspect/{sample}.log",
    script:
        "scripts/inspect_cells.py"


rule example_plane:
    """Example figure: raw channels and detected/rejected spots in one region,
    set under example_plane in config.yaml."""
    input:
        image="data/processed/{sample}/image.zarr",
        candidates=expand("data/processed/{{sample}}/spot_candidates_{channel}.csv",
                          channel=config["channels"]),
    output:
        "results/figures/{sample}_example_plane.png",
    params:
        example=config["example_plane"],
        channels=list(config["channels"]),
        emission_nm={c: v["emission_nm"] for c, v in config["channels"].items()},
        min_amplitude=config["spot_detection"]["min_amplitude"],
        membrane_emission_nm=config["segmentation"]["membrane_emission_nm"],
        nuclei_emission_nm=config["segmentation"]["nuclei_emission_nm"],
    log:
        "logs/example_plane/{sample}.log",
    script:
        "scripts/example_plane.py"


rule count_per_cell:
    """Assign puncta to somata, tagged nuclear, cytoplasmic or (somata without a
    detected nucleus) unknown, and emit a tidy per-cell table."""
    input:
        soma=    "data/processed/{sample}/soma_labels.tif",
        nuclei=  "data/processed/{sample}/nuclei_labels.tif",
        table=   "data/processed/{sample}/cells.csv",
        spots=   expand("data/processed/{{sample}}/spots_{channel}.csv",
                        channel=config["channels"]),
    output:
        counts="data/processed/{sample}/counts.csv",
        spots="data/processed/{sample}/spots_assigned.csv",
    params:
        meta=lambda wc: meta(wc.sample),
        channels=list(config["channels"]),
        downsample=config["segmentation"]["downsample"],
    log:
        "logs/count_per_cell/{sample}.log",
    script:
        "scripts/count_per_cell.py"


rule neurites:
    """Spot density in the driver line's neurites (full-resolution membrane
    mask minus somata), against a shell of surrounding tissue as chance level."""
    input:
        image="data/processed/{sample}/image.zarr",
        soma= "data/processed/{sample}/soma_labels.tif",
        spots=expand("data/processed/{{sample}}/spots_{channel}.csv",
                     channel=config["channels"]),
    output:
        table="data/processed/{sample}/neurite_counts.csv",
        mask= "data/processed/{sample}/neurite_mask.tif",
        qc=   "results/figures/neurites/{sample}_qc.png",
    params:
        segmentation=config["segmentation"],
        neurites=config["neurites"],
        meta=lambda wc: meta(wc.sample),
        channels=list(config["channels"]),
    resources:
        # Full-resolution masks and fragment labels of the deepest stack (365 planes).
        mem_mb=16000,
    log:
        "logs/neurites/{sample}.log",
    script:
        "scripts/neurites.py"


rule aggregate_neurites:
    input:
        expand("data/processed/{sample}/neurite_counts.csv", sample=SAMPLES),
    output:
        "results/tables/neurite_counts.csv",
    run:
        import pandas as pd
        pd.concat([pd.read_csv(f) for f in input], ignore_index=True).to_csv(output[0], index=False)


rule aggregate:
    input:
        expand("data/processed/{sample}/counts.csv", sample=SAMPLES),
    output:
        "results/tables/spot_counts.csv",
    log:
        "logs/aggregate.log",
    script:
        "scripts/aggregate.py"


rule mips:
    """Target: membrane-channel MIPs for every CZI, including excluded QC scans."""
    input:
        expand("results/figures/mip/{sample}_membrane_mip.png", sample=RAW_PATHS),


rule mip:
    """Maximum intensity projection of the membrane-tag channel, for QC. Reads
    the CZI directly (see script) so it needs no ingested zarr."""
    input:
        lambda wc: RAW_PATHS[wc.sample],
    output:
        "results/figures/mip/{sample}_membrane_mip.png",
    wildcard_constraints:
        # Any CZI stem, so excluded QC scans can be inspected too.
        sample="|".join(map(re.escape, RAW_PATHS)),
    params:
        channel_index=config["segmentation_channel"],
        mip=config["mip"],
    resources:
        # Largest stack is 365 x 1920 x 1920 uint16 (~2.7 GB) for one channel.
        mem_mb=6000,
    log:
        "logs/mip/{sample}.log",
    script:
        "scripts/mip.py"


rule figures:
    input:
        "results/tables/spot_counts.csv",
    output:
        "results/figures/counts_by_receptor.pdf",
    log:
        "logs/figures.log",
    script:
        "scripts/plot_counts.py"
